# Credentials and secrets
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
service-account*.json
*token*.json
.netrc
.huggingface/token

# Local environment / OS / editor
.venv*/
venv/
.DS_Store
*.log

# Listening (C5A): individual listener records, sessions and reviewer notes never enter Git.
# Only reviewed aggregates published with `tamil-tts listen publish` may be committed.
listener_results*.jsonl
ratings.jsonl
**/listening/sessions/
**/listening/exports/
