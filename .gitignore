weights/
lightning_logs/
runs/
wandb/
mlruns/

# Local data and generated outputs
data/raw/
data/audio/
data/private/
outputs/
audio/
tamil-tts-data/
tamil-tts-models/
tamil-tts-cache/

# Caches
.cache/
cache/
